# The address of Schreibzeug in the browser (a DNS record pointing to this server)
SCHREIBZEUG_DOMAIN=office.example.org
# For Let's Encrypt
ACME_EMAIL=admin@example.org
# Image tag of tristanteu/schreibzeug: a fixed version, raised by hand for an update (never
# "latest", so a new image never runs unannounced)
SCHREIBZEUG_VERSION=0.1.8
# true: anyone who reaches the server may create an account; otherwise new accounts come through
# sharing links (docs/accounts.md)
#SCHREIBZEUG_OPEN_SIGNUP=true
