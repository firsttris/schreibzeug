{
  "name": "schreibzeug",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "engine:prepare": "bun engine/scripts/prepare.ts",
    "test-files": "bun test-files/make.ts",
    "dev": "bun run engine:prepare && bun run --filter '@schreibzeug/{web,server}' dev",
    "build": "bun run --filter @schreibzeug/web build",
    "preview": "bun run --filter @schreibzeug/web preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "playwright test -c e2e/playwright.config.ts --project=chromium --project=fidelity",
    "server": "bun run --filter @schreibzeug/server dev",
    "screenshots": "playwright test -c e2e/playwright.config.ts --project=screenshots --workers 1",
    "test:fidelity": "playwright test -c e2e/playwright.config.ts --project=fidelity",
    "fidelity:update": "playwright test -c e2e/playwright.config.ts --project=fidelity --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@schreibzeug/einvoice": "workspace:*",
    "@schreibzeug/ooxml": "workspace:*",
    "@schreibzeug/pdf-ocr": "workspace:*",
    "@schreibzeug/pdf-sign": "workspace:*",
    "@types/bun": "1.4.4",
    "fflate": "0.8.3",
    "jose": "6.2.13",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
