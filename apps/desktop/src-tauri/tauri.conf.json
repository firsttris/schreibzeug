{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stapel",
  "version": "../package.json",
  "identifier": "io.github.firsttris.stapel",
  "build": {
    "beforeDevCommand": "bun run sidecar && bun run start:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run start:build && bun run sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Office files, edited together",
    "longDescription": "Documents, spreadsheets and presentations: the files on this computer, or on a Stapel server, edited together in real time.",
    "copyright": "AGPL-3.0-only",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/stapel-local"],
    "resources": {
      "../../web/dist/": "web/"
    }
  }
}
