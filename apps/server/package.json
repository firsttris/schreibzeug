{
  "name": "@schreibzeug/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "The Schreibzeug server: the files API (folders, uploads, versions, trash) on Bun with Hono and SQLite.",
  "exports": {
    ".": "./src/app.ts",
    "./blobs": "./src/blobs.ts",
    "./result": "./src/result.ts",
    "./collab/hub": "./src/collab/hub.ts",
    "./collab/routes": "./src/collab/routes.ts",
    "./web": "./src/web.ts",
    "./files/media": "./src/files/media.ts",
    "./files/mime": "./src/files/mime.ts",
    "./files/serialize": "./src/files/serialize.ts",
    "./auth/middleware": "./src/auth/middleware.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@schreibzeug/files-api": "workspace:*",
    "@schreibzeug/ooxml": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "fflate": "0.8.3"
  }
}
